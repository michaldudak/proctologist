{
	"name": "proctologist-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"lint": "oxlint . && prettier --check .",
		"format": "prettier --write .",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"test:watch": "vitest",
		"app": "pnpm --filter @proctologist/desktop dev",
		"build": "pnpm --filter @proctologist/desktop build",
		"preview": "pnpm build && pnpm --filter @proctologist/desktop start",
		"dist": "pnpm typecheck && pnpm --filter @proctologist/desktop dist",
		"install:app": "pnpm --filter @proctologist/desktop install:app"
	},
	"devDependencies": {
		"@tsconfig/node26": "26.0.1",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "26.5.0",
		"oxlint": "1.82.0",
		"prettier": "3.9.6",
		"typescript": "7.0.2",
		"vitest": "5.0.0"
	}
}
